; Vertex shader: position through the mvp matrix, texture coordinates and
; brightness passed straight on.

.fvec mvp[4]

.constf ones(1.0, 1.0, 1.0, 1.0)

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intc0 v1
.alias inclr v2

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones

	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0

	mov outtc0, intc0

	mov r1.xyz, inclr
	mov r1.w, ones
	mov outclr, r1

	end
.end
